# Arcade configuration. Copy to .env and edit for your Pi.
#   cp .env.example .env

# ── Paths ────────────────────────────────────────────────────────────────────
ARCADE_HOME=/home/arcadeuser
ARCADE_LOG_DIR=/home/arcadeuser/logs
ARCADE_PICO8_BIN=/home/arcadeuser/pico-8/pico8_64
# Python venv used by scripts/run.sh (blinka + piomatter installed here)
ARCADE_VENV=/home/arcadeuser/.venvs/blinka_venv

# ── Display / playback ───────────────────────────────────────────────────────
ARCADE_BRIGHTNESS=0.5
ARCADE_LOOP_LENGTH=60      # seconds per GIF in directory (wallart/christmas) modes
ARCADE_FRAME_DELAY=0.2     # seconds between frames

# Mode the button controller starts in (arcade.service)
ARCADE_DEFAULT_MODE=wallart

# ── GIF sources ──────────────────────────────────────────────────────────────
ARCADE_GIF_DIR_WALLART=/home/arcadeuser/wallart/wallart-gifs
ARCADE_GIF_DIR_CHRISTMAS=/home/arcadeuser/wallart/xmas-gifs
ARCADE_GIF_DIR_BUTTERFLIES=/home/arcadeuser/wallart/butterfly-gifs
# Single GIF looped forever by butterfly mode
ARCADE_BUTTERFLY_GIF=/home/arcadeuser/wallart/butterfly-gifs/butterfly.gif

# ── GPIO buttons (BCM pin numbers; 0 = disabled) ─────────────────────────────
ARCADE_BTN_WALLART_PIN=17
ARCADE_BTN_GAME_PIN=27
ARCADE_BTN_CHRISTMAS_PIN=0
ARCADE_BTN_BUTTERFLIES_PIN=0
ARCADE_BTN_BUTTERFLY_PIN=0
