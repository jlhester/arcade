[Unit]
Description=Arcade LED Panel Controller
After=network.target

[Service]
Type=simple
User=__ARCADE_USER__
# lgpio writes a .lgd-nfy notify file in the working directory; the default
# system-service cwd (/) isn't writable by the service user. /run/arcade is a
# tmpfs dir systemd creates (and cleans up) for us.
RuntimeDirectory=arcade
WorkingDirectory=/run/arcade
EnvironmentFile=-__ARCADE_DIR__/.env
ExecStart=__ARCADE_DIR__/scripts/run.sh
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
